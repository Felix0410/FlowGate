# 本地配置模板；复制到未跟踪的 .env 并填写，勿提交真实秘密。
export JAVA_HOME=/path/to/jdk17
export FG_MYSQL_PORT=13307
export FG_MYSQL_URL='jdbc:mysql://127.0.0.1:13307/flowgate?connectionTimeZone=UTC'
export FG_MYSQL_USERNAME=flowgate
export FG_MYSQL_PASSWORD=''
export FG_MYSQL_ROOT_PASSWORD=''
export FG_REDIS_HOST=127.0.0.1
export FG_REDIS_PORT=16380
export FG_REDIS_PASSWORD=''
export FG_REDIS_DATABASE=0
export FLOWGATE_INTERNAL_KEY=''
export FG_BOOTSTRAP_ADMIN_USERNAME=''
export FG_BOOTSTRAP_ADMIN_BCRYPT=''
export FLOWGATE_ALLOWED_UPSTREAMS=http://127.0.0.1:8085
export FLOWGATE_CONTROL_URI=http://127.0.0.1:8081
export FLOWGATE_NODE_ID=local-gateway
export FLOWGATE_CONSOLE_ORIGIN=http://127.0.0.1:8081

# 可选：仅本机Demo故障演示需要；默认关闭。IDEA启动Demo时也需加载此文件或配置该变量。
export FLOWGATE_DEMO_FAULT_ENABLED='false'

# V11-B：默认关闭；完整B链路/SQL/所有接流节点确认后，由部署负责人显式激活。
export FLOWGATE_QUOTA_ACTIVATION_ENABLED='false'
# 必须是完整接流名单，不能只填当前在线的部分节点。默认空禁止激活。
export FLOWGATE_QUOTA_TRAFFIC_NODES=''

# V11-C：Kafka只用于Control异步读模型，默认关闭，不影响B权威配额。
export FLOWGATE_ASYNC_ENABLED='false'
export FLOWGATE_KAFKA_BOOTSTRAP_SERVERS='127.0.0.1:19092'
export FLOWGATE_USAGE_TOPIC='flowgate.usage.v1'
export FLOWGATE_USAGE_GROUP='flowgate-usage-aggregate-v1'

# SENT未消费补投：默认300秒；应用启动后也须经过完整等待期。生产不建议缩短。
export FLOWGATE_ASYNC_REPLAY_GRACE_SECONDS='300'

# V12仅隔离新环境启用；用户现有数据库不可自动迁移。
FLOWGATE_PORTAL_ENABLED=false
FLOWGATE_V12_QUOTA_ENABLED=false
FLOWGATE_V12_ASYNC_ENABLED=false
FLOWGATE_PORTAL_ORIGINS=
FLOWGATE_RABBITMQ_HOST=127.0.0.1
FLOWGATE_RABBITMQ_PORT=5672
FLOWGATE_RABBITMQ_USERNAME=flowgate
FLOWGATE_RABBITMQ_PASSWORD=
# V12固定独立vhost /flowgate-v12，隔离启动器自动生成密码和端口。
